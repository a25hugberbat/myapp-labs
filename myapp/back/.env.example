# Copia aquest fitxer amb el nom .env i posa-hi les teves dades.
# El fitxer .env no es puja mai a GitHub (està al .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_USER=usuari_de_la_bd
DB_PASSWORD=la_teva_contrasenya
DB_NAME=nom_de_la_bd

# Només al servidor (Hestia), per connectar pel socket de MySQL:
# DB_SOCKET=/run/mysqld/mysqld.sock
